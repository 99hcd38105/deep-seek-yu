{
  "name": "deepseek-harness-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "deep seek yu desktop client",
  "author": "Local build",
  "main": "main.js",
  "scripts": {
    "postinstall": "node scripts/apply-harness-core-patches.mjs",
    "start": "electron .",
    "test:internal-vision": "node scripts/test-harness-local-vision.mjs && node scripts/test-deepseek-local-vision-adapter.mjs",
    "build": "electron-packager . \"deep seek yu\" --platform=win32 --arch=x64 --icon=assets/deep-seek-yu-icon.ico --out=dist --overwrite --prune=true",
    "installer": "electron-builder --win nsis"
  },
  "dependencies": {
    "@deep-seek-yu/account-status": "file:harness-plugins/account-status",
    "@deep-seek-yu/desktop-companion": "file:harness-plugins/desktop-companion",
    "@deep-seek-yu/local-vision": "file:harness-plugins/local-vision",
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.1-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.1.1-rc.2",
    "@deepseek-ai/dsh-bash-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-code-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-compaction": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-output-retention": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.1.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-telemetry": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-title-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-shell": "0.1.1-rc.2",
    "@deepseek-ai/dsh-spill": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-workflow": "0.1.1-rc.2",
    "@huggingface/transformers": "^4.2.0",
    "pnpm": "11.22.0",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "playwright": "^1.62.1"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "sharp": "0.35.3"
  },
  "build": {
    "appId": "ai.deepseek.harness.desktop",
    "productName": "deep seek yu",
    "asar": false,
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "compression": "normal",
    "directories": {
      "output": "installer"
    },
    "files": [
      "main.js",
      "mobile-gateway.mjs",
      "local-vision.js",
      "harness-plugins/**/*",
      "pet-manager.js",
      "pet-preload.js",
      "pet-window.html",
      "pet-settings.html",
      "extensions-manager.js",
      "extensions-preload.js",
      "extensions-window.html",
      "harness-runtime-manager.js",
      "scripts/apply-harness-core-patches.mjs",
      "THIRD_PARTY_NOTICES.md",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/deep-seek-yu-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "deep-seek-yu-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "deep seek yu",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/deep-seek-yu-icon.ico",
      "uninstallerIcon": "assets/deep-seek-yu-icon.ico"
    }
  }
}
